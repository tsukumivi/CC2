{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "java-fieldnotes-learning-studio",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "java-fieldnotes",
      "database_id": "0712824c-c019-4430-9748-c1c9f35b0800",
      "migrations_dir": "./cloudflare/migrations"
    }
  ],
  "vars": {
    "MONTHLY_EXECUTION_LIMIT": "500"
  },
  "triggers": {
    "crons": ["0 4 * * *"]
  }
}
